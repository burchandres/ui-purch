{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "trailingComma": "all",
  "semi": true,
  "singleQuote": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "schema.graphqls",
    "src/graphql-env.d.ts",
    "playwright-report/",
    "test-results/",
    "dist/",
    "coverage/"
  ]
}
